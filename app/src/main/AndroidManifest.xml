<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="br.com.casa.launcher">
    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="28" />
    <queries>
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.netflix.ninja" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.disney.disneyplus" />
    </queries>
    <application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="Casa" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
